def seed_everything(seed):
    random.seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)


# ============================================================
# Model loading
# ============================================================

def get_ckpt_value(ckpt, key, default):
    return ckpt[key] if key in ckpt else default


def load_image_pfn_from_checkpoint(checkpoint_path, device):
    ckpt = torch.load(checkpoint_path, map_location=device)

    image_size = get_ckpt_value(ckpt, "image_size", IMAGE_SIZE)
    patch_size = get_ckpt_value(ckpt, "patch_size", 8)

    print("Checkpoint model config:")
    print(f"  image_size: {image_size}")
    print(f"  patch_size: {patch_size}")
    print(f"  image_embed_dim: {get_ckpt_value(ckpt, 'image_embed_dim', 256)}")
    print(f"  image_depth: {get_ckpt_value(ckpt, 'image_depth', 4)}")
    print(f"  image_heads: {get_ckpt_value(ckpt, 'image_heads', 8)}")
    print(f"  set_embed_dim: {get_ckpt_value(ckpt, 'set_embed_dim', 256)}")
    print(f"  set_depth: {get_ckpt_value(ckpt, 'set_depth', 4)}")
    print(f"  set_heads: {get_ckpt_value(ckpt, 'set_heads', 8)}")
    print(f"  label_embed_dim: {get_ckpt_value(ckpt, 'label_embed_dim', 32)}")
    print(f"  dropout: {get_ckpt_value(ckpt, 'dropout', 0.0)}")

    model = ImagePFN(
        image_size=image_size,
        patch_size=patch_size,

        image_embed_dim=get_ckpt_value(ckpt, "image_embed_dim", 256),
        image_depth=get_ckpt_value(ckpt, "image_depth", 4),
        image_heads=get_ckpt_value(ckpt, "image_heads", 8),

        set_embed_dim=get_ckpt_value(ckpt, "set_embed_dim", 256),
        set_depth=get_ckpt_value(ckpt, "set_depth", 4),
        set_heads=get_ckpt_value(ckpt, "set_heads", 8),

        label_embed_dim=get_ckpt_value(ckpt, "label_embed_dim", 32),
        dropout=get_ckpt_value(ckpt, "dropout", 0.0),
        num_classes=2,
    ).to(device)

    model.load_state_dict(ckpt["model_state_dict"], strict=True)
    model.eval()

    for p in model.parameters():
        p.requires_grad = False

    return model, ckpt


def extract_query_logits(outputs):
    if isinstance(outputs, dict):
        if "query_logits" in outputs:
            return outputs["query_logits"]
        if "logits" in outputs:
            return outputs["logits"]
        raise KeyError(f"Could not find logits. Output keys: {list(outputs.keys())}")

    if torch.is_tensor(outputs):
        return outputs

    raise TypeError(f"Unsupported model output type: {type(outputs)}")


# ============================================================
# CIFAR-10 binary dataset
# ============================================================

@dataclass
class BinaryTaskSpec:
    task_name: str
    class0_name: str
    class1_name: str
    class0_cifar_idx: int
    class1_cifar_idx: int


def make_binary_task_spec(class0_name, class1_name):
    if class0_name not in CIFAR10_CLASS_NAMES:
        raise ValueError(f"Unknown CIFAR-10 class0_name: {class0_name}")

    if class1_name not in CIFAR10_CLASS_NAMES:
        raise ValueError(f"Unknown CIFAR-10 class1_name: {class1_name}")

    class0_idx = CIFAR10_CLASS_NAMES.index(class0_name)
    class1_idx = CIFAR10_CLASS_NAMES.index(class1_name)

    task_name = f"{class0_name}_vs_{class1_name}"

    return BinaryTaskSpec(
        task_name=task_name,
        class0_name=class0_name,
        class1_name=class1_name,
        class0_cifar_idx=class0_idx,
        class1_cifar_idx=class1_idx,
    )


class CIFAR10BinaryDataset(Dataset):
    """
    Binary CIFAR-10 subset.

    For a given task:
        class0_name -> label 0
        class1_name -> label 1

    Uses both CIFAR train and test when wrapped by CombinedCIFAR10BinaryDataset.
    """

    def __init__(
        self,
        cifar_dataset,
        task_spec,
        image_size=32,
        split_name="unknown",
    ):
        self.cifar = cifar_dataset
        self.task_spec = task_spec
        self.split_name = split_name

        self.samples = []

        for idx in range(len(self.cifar)):
            _img, target = self.cifar[idx]

            if target == task_spec.class0_cifar_idx:
                self.samples.append(
                    {
                        "idx": idx,
                        "label": 0,
                        "class_name": task_spec.class0_name,
                        "cifar_target": target,
                        "split": split_name,
                    }
                )

            elif target == task_spec.class1_cifar_idx:
                self.samples.append(
                    {
                        "idx": idx,
                        "label": 1,
                        "class_name": task_spec.class1_name,
                        "cifar_target": target,
                        "split": split_name,
                    }
                )

        self.transform = transforms.Compose([
            transforms.Resize((image_size, image_size)),
            transforms.ToTensor(),
        ])

    def __len__(self):
        return len(self.samples)

    def __getitem__(self, idx):
        item = self.samples[idx]

        pil_img, _target = self.cifar[item["idx"]]
        img = self.transform(pil_img)

        label = torch.tensor(item["label"], dtype=torch.long)

        return img, label

    def get_sample_info(self, idx):
        return self.samples[idx]


class CombinedCIFAR10BinaryDataset(Dataset):
    """
    Combines train and test CIFAR-10 binary subsets while preserving get_sample_info().
    """

    def __init__(self, datasets):
        self.datasets = list(datasets)

        self.cumulative_sizes = []
        total = 0

        for dataset in self.datasets:
            total += len(dataset)
            self.cumulative_sizes.append(total)

        if total == 0:
            raise ValueError("Combined dataset has zero samples.")

    def __len__(self):
        return self.cumulative_sizes[-1]

    def _resolve_index(self, idx):
        dataset_idx = 0

        while idx >= self.cumulative_sizes[dataset_idx]:
            dataset_idx += 1

        previous_total = 0 if dataset_idx == 0 else self.cumulative_sizes[dataset_idx - 1]
        local_idx = idx - previous_total

        return dataset_idx, local_idx

    def __getitem__(self, idx):
        dataset_idx, local_idx = self._resolve_index(idx)
        return self.datasets[dataset_idx][local_idx]

    def get_sample_info(self, idx):
        dataset_idx, local_idx = self._resolve_index(idx)
        return self.datasets[dataset_idx].get_sample_info(local_idx)


def load_cifar10_base(root=CIFAR_ROOT):
    train_base = CIFAR10(
        root=root,
        train=True,
        download=True,
    )

    test_base = CIFAR10(
        root=root,
        train=False,
        download=True,
    )

    return train_base, test_base


def make_binary_dataset_from_cifar(
    train_base,
    test_base,
    task_spec,
    image_size,
):
    train_binary = CIFAR10BinaryDataset(
        cifar_dataset=train_base,
        task_spec=task_spec,
        image_size=image_size,
        split_name="train",
    )

    test_binary = CIFAR10BinaryDataset(
        cifar_dataset=test_base,
        task_spec=task_spec,
        image_size=image_size,
        split_name="test",
    )

    dataset = CombinedCIFAR10BinaryDataset(
        datasets=[train_binary, test_binary],
    )

    return dataset


