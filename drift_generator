            "DIVERSITY_LOSS_WEIGHT": DIVERSITY_LOSS_WEIGHT,
            "DIVERSITY_SIM_CEILING": DIVERSITY_SIM_CEILING,
            "FEATURE_BACKBONE": "moco_v2_resnet50",
            "FEATURE_LAYERS": FEATURE_LAYERS,
            "FEATURE_WEIGHTS": FEATURE_WEIGHTS,
            "MOCO_CHECKPOINT_PATH": MOCO_CHECKPOINT_PATH,
        },
        path,
    )

    print(f"Saved checkpoint: {path}")


# ============================================================
# Training
# ============================================================

def train_stl_feature_drift_relational_diversity(
    steps=STEPS,
    data_batch_size=DATA_BATCH_SIZE,
    gen_batch_size=GEN_BATCH_SIZE,
    lr=LR,
    temp=DRIFT_TEMPERATURE,
    in_dim=IN_DIM,
    hidden=HIDDEN,
    seed=SEED,
):
    """
    Trains for a fixed number of optimizer steps, but prints a true
    average across all batches within each completed epoch.

    With:
        DATASET_SIZE = 10000
        batch_size = 2048
        drop_last = True

    each epoch has floor(10000 / 2048) = 4 optimizer steps.

    Loss:
        total_loss =
            DRIFT_LOSS_WEIGHT * drift_loss
            + RELATIONAL_LOSS_WEIGHT * relational_loss
            + DIVERSITY_LOSS_WEIGHT * diversity_loss
    """

    seed_everything(seed)

    out_dim = 3 * IMAGE_SIZE * IMAGE_SIZE

    model = MLP(
        in_dim=in_dim,
        hidden=hidden,
        out_dim=out_dim,
    ).to(DEVICE)

    feature_extractor = FrozenMoCoResNet50Features(
        layers=FEATURE_LAYERS,
        checkpoint_path=MOCO_CHECKPOINT_PATH,
        checkpoint_url=MOCO_CHECKPOINT_URL,
    ).to(DEVICE)

    feature_extractor.eval()

    opt = torch.optim.Adam(model.parameters(), lr=lr)

    loader = build_stl_loader(batch_size=data_batch_size)

    step_total_loss_history = []
    step_drift_loss_history = []
    step_rel_loss_history = []
    step_div_loss_history = []

    epoch_total_loss_history = []
    epoch_drift_loss_history = []
    epoch_rel_loss_history = []
    epoch_div_loss_history = []

    global_step = 0
    epoch = 0

    fixed_z = torch.randn(64, in_dim, device=DEVICE)

    print("=" * 80)
    print("Training STL feature-space drift + z-relational + diversity model")
    print("=" * 80)
    print(f"feature backbone: MoCo v2 ResNet-50")
    print(f"steps: {steps}")
    print(f"data_batch_size: {data_batch_size}")
    print(f"gen_batch_size: {gen_batch_size}")
    print(f"lr: {lr}")
    print(f"drift temp: {temp}")
    print(f"in_dim: {in_dim}")
    print(f"hidden: {hidden}")
    print(f"IMAGE_SIZE: {IMAGE_SIZE}")
    print(f"out_dim: {out_dim}")
    print(f"DRIFT_LOSS_WEIGHT: {DRIFT_LOSS_WEIGHT}")
    print(f"RELATIONAL_LOSS_WEIGHT: {RELATIONAL_LOSS_WEIGHT}")
    print(f"DIVERSITY_LOSS_WEIGHT: {DIVERSITY_LOSS_WEIGHT}")
    print(f"DIVERSITY_SIM_CEILING: {DIVERSITY_SIM_CEILING}")
    print(f"FEATURE_LAYERS: {FEATURE_LAYERS}")
    print(f"FEATURE_WEIGHTS: {FEATURE_WEIGHTS}")
    print(f"MOCO_CHECKPOINT_PATH: {MOCO_CHECKPOINT_PATH}")
    print("=" * 80)

    pbar = tqdm(total=steps, desc="Training steps")

    while global_step < steps:
        epoch_total_loss = 0.0
        epoch_drift_loss = 0.0
        epoch_rel_loss = 0.0
        epoch_div_loss = 0.0
        epoch_num_batches = 0

        epoch_layer_sums = {}
        epoch_layer_counts = {}

        last_real_img = None

        for real_images, _ in loader:
            if global_step >= steps:
                break

            real_images = real_images.to(DEVICE, non_blocking=True)

            z = torch.randn(gen_batch_size, in_dim, device=DEVICE)

            gen_raw = model(z)
            gen_images = flat_to_img(gen_raw)

            with torch.no_grad():
                real_features = feature_extractor(real_images)

            gen_features = feature_extractor(gen_images)

            drift_loss, drift_logs = drifting_feature_loss(
                gen_features=gen_features,
                real_features=real_features,
                temperature=temp,
                feature_weights=FEATURE_WEIGHTS,
            )

            relational_loss, rel_logs = batchwise_relational_loss(
                gen_features=gen_features,
                z=z,
                feature_weights=FEATURE_WEIGHTS,
            )

            diversity_loss, div_logs = batchwise_diversity_ceiling_loss(
                gen_features=gen_features,
                feature_weights=FEATURE_WEIGHTS,
                ceiling=DIVERSITY_SIM_CEILING,
            )

            total_loss = (
                DRIFT_LOSS_WEIGHT * drift_loss
                + RELATIONAL_LOSS_WEIGHT * relational_loss
                + DIVERSITY_LOSS_WEIGHT * diversity_loss
            )

            opt.zero_grad(set_to_none=True)
            total_loss.backward()
            opt.step()

            total_loss_val = float(total_loss.item())
            drift_loss_val = float(drift_loss.item())
            rel_loss_val = float(relational_loss.item())
            div_loss_val = float(diversity_loss.item())

            step_total_loss_history.append(total_loss_val)
            step_drift_loss_history.append(drift_loss_val)
            step_rel_loss_history.append(rel_loss_val)
            step_div_loss_history.append(div_loss_val)

            epoch_total_loss += total_loss_val
            epoch_drift_loss += drift_loss_val
            epoch_rel_loss += rel_loss_val
            epoch_div_loss += div_loss_val
            epoch_num_batches += 1

            all_logs = {}
            all_logs.update(drift_logs)
            all_logs.update(rel_logs)
            all_logs.update(div_logs)

            for k, v in all_logs.items():
                epoch_layer_sums[k] = epoch_layer_sums.get(k, 0.0) + float(v)
                epoch_layer_counts[k] = epoch_layer_counts.get(k, 0) + 1

            last_real_img = real_images

            global_step += 1
            pbar.update(1)
            pbar.set_postfix(
                total=f"{total_loss_val:.3e}",
                drift=f"{drift_loss_val:.3e}",
                rel=f"{rel_loss_val:.3e}",
                div=f"{div_loss_val:.3e}",
            )

            if global_step == 1 or global_step % PLOT_EVERY == 0:
                with torch.no_grad():
                    vis_raw = model(fixed_z)
                    vis_img = flat_to_img(vis_raw)

                save_image_comparison(
                    real_img=last_real_img,
                    gen_img=vis_img,
                    step=global_step,
                    epoch=epoch,
                )

                save_relational_cosine_row(
                    model=model,
                    step=global_step,
                    epoch=epoch,
                    in_dim=in_dim,
                )

                save_loss_curve(
                    step_total_loss_history=step_total_loss_history,
                    step_drift_loss_history=step_drift_loss_history,
                    step_rel_loss_history=step_rel_loss_history,
                    step_div_loss_history=step_div_loss_history,
                    epoch_total_loss_history=epoch_total_loss_history,
                    epoch_drift_loss_history=epoch_drift_loss_history,
                    epoch_rel_loss_history=epoch_rel_loss_history,
                    epoch_div_loss_history=epoch_div_loss_history,
                )

            if global_step > 0 and global_step % SAVE_EVERY == 0:
                save_checkpoint(
                    model=model,
                    opt=opt,
                    step=global_step,
                    epoch=epoch,
                    in_dim=in_dim,
                    hidden=hidden,
                    temp=temp,
                )

        if epoch_num_batches > 0:
            avg_epoch_total_loss = epoch_total_loss / epoch_num_batches
            avg_epoch_drift_loss = epoch_drift_loss / epoch_num_batches
            avg_epoch_rel_loss = epoch_rel_loss / epoch_num_batches
            avg_epoch_div_loss = epoch_div_loss / epoch_num_batches

            epoch_total_loss_history.append(avg_epoch_total_loss)
            epoch_drift_loss_history.append(avg_epoch_drift_loss)
            epoch_rel_loss_history.append(avg_epoch_rel_loss)
            epoch_div_loss_history.append(avg_epoch_div_loss)

            avg_layer_logs = {
                k: epoch_layer_sums[k] / max(epoch_layer_counts[k], 1)
                for k in sorted(epoch_layer_sums.keys())
            }

            layer_msg = " | ".join([
                f"{k}: {v:.6f}"
                for k, v in avg_layer_logs.items()
            ])

            print(
                f"\nEpoch {epoch:04d} complete | "
                f"steps_seen: {global_step:06d}/{steps} | "
                f"avg_total_loss: {avg_epoch_total_loss:.8f} | "
                f"avg_drift_loss: {avg_epoch_drift_loss:.8f} | "
                f"avg_rel_loss: {avg_epoch_rel_loss:.8f} | "
                f"avg_div_loss: {avg_epoch_div_loss:.8f} | "
                f"{layer_msg}\n"
            )

            save_loss_curve(
                step_total_loss_history=step_total_loss_history,
                step_drift_loss_history=step_drift_loss_history,
                step_rel_loss_history=step_rel_loss_history,
                step_div_loss_history=step_div_loss_history,
                epoch_total_loss_history=epoch_total_loss_history,
                epoch_drift_loss_history=epoch_drift_loss_history,
                epoch_rel_loss_history=epoch_rel_loss_history,
                epoch_div_loss_history=epoch_div_loss_history,
            )

        epoch += 1

    pbar.close()

    save_checkpoint(
        model=model,
        opt=opt,
        step=global_step,
        epoch=epoch,
        in_dim=in_dim,
        hidden=hidden,
        temp=temp,
    )

    final_path = os.path.join(CHECKPOINT_DIR, "model_final.pth")
    torch.save(
        {
            "step": global_step,
            "epoch": epoch,
            "model": model.state_dict(),
            "optimizer": opt.state_dict(),
            "IMAGE_SIZE": IMAGE_SIZE,
            "IN_DIM": in_dim,
            "HIDDEN": hidden,
            "DRIFT_TEMPERATURE": temp,
            "DRIFT_LOSS_WEIGHT": DRIFT_LOSS_WEIGHT,
            "RELATIONAL_LOSS_WEIGHT": RELATIONAL_LOSS_WEIGHT,
            "DIVERSITY_LOSS_WEIGHT": DIVERSITY_LOSS_WEIGHT,
            "DIVERSITY_SIM_CEILING": DIVERSITY_SIM_CEILING,
            "FEATURE_BACKBONE": "moco_v2_resnet50",
            "FEATURE_LAYERS": FEATURE_LAYERS,
            "FEATURE_WEIGHTS": FEATURE_WEIGHTS,
            "MOCO_CHECKPOINT_PATH": MOCO_CHECKPOINT_PATH,
        },
        final_path,
    )

    save_loss_curve(
        step_total_loss_history=step_total_loss_history,
        step_drift_loss_history=step_drift_loss_history,
        step_rel_loss_history=step_rel_loss_history,
        step_div_loss_history=step_div_loss_history,
        epoch_total_loss_history=epoch_total_loss_history,
        epoch_drift_loss_history=epoch_drift_loss_history,
        epoch_rel_loss_history=epoch_rel_loss_history,
        epoch_div_loss_history=epoch_div_loss_history,
    )

    print("Training complete.")
    print(f"Saved final checkpoint: {final_path}")

    return (
        model,
        step_total_loss_history,
        step_drift_loss_history,
        step_rel_loss_history,
        step_div_loss_history,
        epoch_total_loss_history,
        epoch_drift_loss_history,
        epoch_rel_loss_history,
        epoch_div_loss_history,
    )


