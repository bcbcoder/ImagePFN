# ============================================================
# STL loader
# ============================================================

def build_stl_loader(batch_size):
    tfm = T.Compose([
        T.Resize((IMAGE_SIZE, IMAGE_SIZE)),
        T.ToTensor(),
        T.Normalize([0.5, 0.5, 0.5], [0.5, 0.5, 0.5]),
    ])

    dataset = torchvision.datasets.STL10(
        root=DATA_ROOT,
        split="unlabeled",
        download=True,
        transform=tfm,
    )

    g = torch.Generator().manual_seed(RANDOM_SEED)
    perm = torch.randperm(len(dataset), generator=g)[:DATASET_SIZE]
    subset = Subset(dataset, perm.tolist())

    loader = DataLoader(
        subset,
        batch_size=batch_size,
        shuffle=True,
        num_workers=NUM_WORKERS,
        pin_memory=(DEVICE.type == "cuda"),
        drop_last=True,
    )

    return loader


# ============================================================
# MLP generator
# ============================================================

class MLP(nn.Module):
    """
    Simple MLP generator:

        z -> hidden -> hidden -> hidden -> flattened image

    z is the only input.
    There is no separate y vector.
    """

    def __init__(self, in_dim=32, hidden=256, out_dim=3 * IMAGE_SIZE * IMAGE_SIZE):
        super().__init__()

        self.net = nn.Sequential(
            nn.Linear(in_dim, hidden), nn.SiLU(),
            nn.Linear(hidden, hidden), nn.SiLU(),
            nn.Linear(hidden, hidden), nn.SiLU(),
            nn.Linear(hidden, out_dim),
        )

    def forward(self, z):
        return self.net(z)


def flat_to_img(x_flat):
    """
    Convert flattened generated output to image.

    MLP output:
        [B, 3*H*W]

    Image output:
        [B, 3, H, W] in [-1, 1]
    """
    x_img = x_flat.view(x_flat.shape[0], 3, IMAGE_SIZE, IMAGE_SIZE)
    x_img = torch.tanh(x_img)
    return x_img



def download_file_if_missing(url, path):
    if os.path.exists(path):
        print(f"MoCo checkpoint already exists: {path}")
        return

    if not DOWNLOAD_MOCO_IF_MISSING:
        raise FileNotFoundError(
            f"MoCo checkpoint not found at {path}. "
            f"Set DOWNLOAD_MOCO_IF_MISSING=True or manually place the file there."
        )

    os.makedirs(os.path.dirname(path), exist_ok=True)
    print(f"Downloading MoCo checkpoint to: {path}")
    print("This can take a little while the first time.")

    urllib.request.urlretrieve(url, path)

    print(f"Downloaded MoCo checkpoint: {path}")


def load_moco_v2_resnet50(checkpoint_path):
    
    model = resnet50(weights=None)

    ckpt = torch.load(checkpoint_path, map_location="cpu")

    if "state_dict" in ckpt:
        state_dict = ckpt["state_dict"]
    else:
        state_dict = ckpt

    new_state_dict = {}

    for k, v in state_dict.items():
        # Keep only the query encoder.
        if k.startswith("module.encoder_q."):
            new_k = k.replace("module.encoder_q.", "")

            # Skip MoCo projection head / classifier.
            if new_k.startswith("fc."):
                continue

            new_state_dict[new_k] = v

    missing, unexpected = model.load_state_dict(new_state_dict, strict=False)


    if len(missing) > 0:
        print("First few missing keys:")
        for k in missing[:10]:
            print(f"  {k}")

    if len(unexpected) > 0:
        print("First few unexpected keys:")
        for k in unexpected[:10]:
            print(f"  {k}")

    return model


# ============================================================
# Frozen MoCo feature extractor
# ============================================================

class FrozenMoCoResNet50Features(nn.Module):
    """
    Frozen MoCo v2 ResNet-50 feature extractor.

    Input:
        images in [-1, 1], shape [B, 3, H, W]

    Output:
        dict of pooled, normalized feature vectors:
            {
                "layer1": [B, C1],
                "layer2": [B, C2],
                "layer3": [B, C3],
            }

    The same feature extractor is used for:
        - drift loss
        - relational loss
        - diversity loss
    """

    def __init__(
        self,
        layers=("layer1", "layer2", "layer3"),
        checkpoint_path=MOCO_CHECKPOINT_PATH,
        checkpoint_url=MOCO_CHECKPOINT_URL,
    ):
        super().__init__()

        download_file_if_missing(checkpoint_url, checkpoint_path)
        backbone = load_moco_v2_resnet50(checkpoint_path)

        self.stem = nn.Sequential(
            backbone.conv1,
            backbone.bn1,
            backbone.relu,
            backbone.maxpool,
        )

        self.layer1 = backbone.layer1
        self.layer2 = backbone.layer2
        self.layer3 = backbone.layer3
        self.layer4 = backbone.layer4

        self.layers = set(layers)

        for p in self.parameters():
            p.requires_grad = False

        self.eval()

        self.register_buffer(
            "mean",
            torch.tensor([0.485, 0.456, 0.406]).view(1, 3, 1, 1),
        )
        self.register_buffer(
            "std",
            torch.tensor([0.229, 0.224, 0.225]).view(1, 3, 1, 1),
        )

    def forward(self, images):
        x = (images + 1.0) / 2.0
        x = (x - self.mean) / self.std

        feats = {}

        x = self.stem(x)

        x = self.layer1(x)
        if "layer1" in self.layers:
            feats["layer1"] = self._pool_norm(x)

        x = self.layer2(x)
        if "layer2" in self.layers:
            feats["layer2"] = self._pool_norm(x)

        x = self.layer3(x)
        if "layer3" in self.layers:
            feats["layer3"] = self._pool_norm(x)

        x = self.layer4(x)
        if "layer4" in self.layers:
            feats["layer4"] = self._pool_norm(x)

        return feats

    def _pool_norm(self, x):
        x = F.adaptive_avg_pool2d(x, output_size=1).flatten(1)
        x = F.normalize(x, dim=1)
        return x


# ============================================================
# Feature-space drifting loss
# ============================================================

def pairwise_l2(a, b):
    return torch.cdist(a, b, p=2)


def compute_drift_target_features(
    gen_feat,
    real_feat,
    temperature=0.25,
):
    """
    Computes:

        target = stopgrad(gen_feat + V)

    where:

        V = pos_mean - neg_mean

    pos_mean:
        nearby real features.

    neg_mean:
        nearby generated features.

    This gives attraction toward real STL features and repulsion from
    nearby generated features.
    """

    with torch.no_grad():
        gen_detach = gen_feat.detach()
        real_detach = real_feat.detach()

        dist_pos = pairwise_l2(gen_detach, real_detach)
        w_pos = F.softmax(-dist_pos / temperature, dim=1)
        pos_mean = w_pos @ real_detach

        dist_neg = pairwise_l2(gen_detach, gen_detach)
        w_neg = F.softmax(-dist_neg / temperature, dim=1)
        neg_mean = w_neg @ gen_detach

        drift = pos_mean - neg_mean
        target = gen_detach + drift

    return target


def drifting_feature_loss(
    gen_features,
    real_features,
    temperature=0.25,
    feature_weights=None,
):
    """
    Multi-layer feature-space drifting loss.

    For each feature layer:

        target = stopgrad(gen_feature + drift)
        loss = MSE(gen_feature, target)

    Then the layer losses are combined with FEATURE_WEIGHTS.
    """

    total_loss = 0.0
    logs = {}

    if feature_weights is None:
        feature_weights = {k: 1.0 for k in gen_features.keys()}

    weight_sum = 0.0

    for name in gen_features.keys():
        gen_feat = gen_features[name]
        real_feat = real_features[name]

        target = compute_drift_target_features(
            gen_feat=gen_feat,
            real_feat=real_feat,
            temperature=temperature,
        )

        loss = F.mse_loss(gen_feat, target)

        w = float(feature_weights.get(name, 1.0))

        total_loss = total_loss + w * loss
        weight_sum += w

        with torch.no_grad():
            sim_to_real = gen_feat @ real_feat.T
            nn_sim = sim_to_real.max(dim=1).values.mean()
            avg_real_sim = sim_to_real.mean()

        logs[f"drift_{name}_loss"] = float(loss.item())
        logs[f"drift_{name}_nn_sim"] = float(nn_sim.item())
        logs[f"drift_{name}_avg_real_sim"] = float(avg_real_sim.item())

    total_loss = total_loss / max(weight_sum, 1e-8)

    return total_loss, logs


# ============================================================
# Z-based relational loss
# ============================================================

def cosine_similarity_matrix(x, eps=1e-8):
    """
    Computes pairwise cosine similarity.
    """
    x = F.normalize(x, dim=1, eps=eps)
    return x @ x.T


def offdiag_mask(B, device):
    return ~torch.eye(B, dtype=torch.bool, device=device)


def offdiag_mse(sim_a, sim_b):
    """
    MSE between off-diagonal entries of two similarity matrices.
    """
    B = sim_a.shape[0]
    mask = offdiag_mask(B, sim_a.device)

    return F.mse_loss(
        sim_a[mask],
        sim_b[mask],
    )


def batchwise_relational_loss(
    gen_features,
    z,
    feature_weights=None,
):
    """
    Batchwise relational loss.

    Uses the same z vector that generated the image.

    Target:
        sim_z[i, j] = cosine(z_i, z_j)

    Image side:
        sim_img_layer[i, j] = cosine(phi_layer(img_i), phi_layer(img_j))

    Objective:
        sim_img_layer should match sim_z.
    """

    if feature_weights is None:
        feature_weights = {k: 1.0 for k in gen_features.keys()}

    z_norm = F.normalize(z, dim=1, eps=1e-8)
    sim_z = z_norm @ z_norm.T

    total_loss = 0.0
    weight_sum = 0.0
    logs = {}

    for name, feat in gen_features.items():
        sim_img = cosine_similarity_matrix(feat)
        loss = offdiag_mse(sim_img, sim_z)

        w = float(feature_weights.get(name, 1.0))

        total_loss = total_loss + w * loss
        weight_sum += w

        with torch.no_grad():
            B = sim_img.shape[0]
            mask = offdiag_mask(B, sim_img.device)

            img_off = sim_img[mask]
            z_off = sim_z[mask]

            img_mean = img_off.mean()
            z_mean = z_off.mean()

            img_std = img_off.std(unbiased=False)
            z_std = z_off.std(unbiased=False)

            corr_num = ((img_off - img_mean) * (z_off - z_mean)).mean()
            corr_den = img_std * z_std + 1e-8
            corr = corr_num / corr_den

        logs[f"rel_{name}_loss"] = float(loss.item())
        logs[f"rel_{name}_corr"] = float(corr.item())
        logs[f"rel_{name}_img_sim_mean"] = float(img_mean.item())
        logs[f"rel_{name}_z_sim_mean"] = float(z_mean.item())

    total_loss = total_loss / max(weight_sum, 1e-8)

    return total_loss, logs


# ============================================================
# Diversity ceiling loss
# ============================================================

def batchwise_diversity_ceiling_loss(
    gen_features,
    feature_weights=None,
    ceiling=DIVERSITY_SIM_CEILING,
):
    """
    Batchwise diversity loss with a similarity ceiling.

    For each feature layer:

        sim_img = cosine(phi(img_i), phi(img_j))

    For off-diagonal pairs only, penalize:

        relu(sim_img - ceiling)^2

    This means:
        - if two generated images are below the similarity ceiling, no penalty
        - if they become too similar, penalty increases smoothly

    """

    if feature_weights is None:
        feature_weights = {k: 1.0 for k in gen_features.keys()}

    total_loss = 0.0
    weight_sum = 0.0
    logs = {}

    for name, feat in gen_features.items():
        sim_img = cosine_similarity_matrix(feat)

        B = sim_img.shape[0]
        mask = offdiag_mask(B, sim_img.device)
        sim_off = sim_img[mask]

        penalty = F.relu(sim_off - ceiling)
        loss = (penalty ** 2).mean()

        w = float(feature_weights.get(name, 1.0))

        total_loss = total_loss + w * loss
        weight_sum += w

        with torch.no_grad():
            frac_above = (sim_off > ceiling).float().mean()
            sim_mean = sim_off.mean()
            sim_max = sim_off.max()
            penalty_mean = penalty.mean()

        logs[f"div_{name}_loss"] = float(loss.item())
        logs[f"div_{name}_sim_mean"] = float(sim_mean.item())
        logs[f"div_{name}_sim_max"] = float(sim_max.item())
        logs[f"div_{name}_frac_above"] = float(frac_above.item())
        logs[f"div_{name}_penalty_mean"] = float(penalty_mean.item())

    total_loss = total_loss / max(weight_sum, 1e-8)

    return total_loss, logs


# ============================================================
# Cosine-controlled visualization vectors
# ============================================================

def make_cosine_similarity_row_vectors(
    in_dim,
    device,
    target_sims=RELATIONAL_VIS_TARGET_SIMS,
):
    """
    Creates a single row of unit vectors with controlled cosine similarity
    relative to the first vector.

    First vector:
        e1 = [1, 0, 0, ..., 0]

    For target cosine c:
        v = [c, sqrt(1-c^2), 0, ..., 0]

    This gives:
        cosine(e1, v) = c
    """

    if in_dim < 2:
        raise ValueError("in_dim must be at least 2 for cosine-controlled visualization.")

    vectors = []

    for c in target_sims:
        c = float(max(-1.0, min(1.0, c)))
        radius = math.sqrt(max(0.0, 1.0 - c * c))

        v = torch.zeros(in_dim, device=device, dtype=torch.float32)
        v[0] = c
        v[1] = radius

        vectors.append(v)

    z_vis = torch.stack(vectors, dim=0)
    z_vis = F.normalize(z_vis, dim=1, eps=1e-8)

    return z_vis


