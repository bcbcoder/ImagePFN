def denorm(x):
    return (x.clamp(-1, 1) + 1.0) / 2.0


def save_image_comparison(real_img, gen_img, step, epoch):
    real_path = os.path.join(SAMPLE_DIR, f"real_epoch_{epoch:04d}_step_{step:06d}.png")
    gen_path = os.path.join(SAMPLE_DIR, f"generated_epoch_{epoch:04d}_step_{step:06d}.png")
    comparison_path = os.path.join(SAMPLE_DIR, f"comparison_epoch_{epoch:04d}_step_{step:06d}.png")

    real_grid = denorm(real_img[:64].detach().cpu())
    gen_grid = denorm(gen_img[:64].detach().cpu())

    vutils.save_image(real_grid, real_path, nrow=8, padding=2)
    vutils.save_image(gen_grid, gen_path, nrow=8, padding=2)

    comparison = torch.cat([real_grid[:32], gen_grid[:32]], dim=0)
    vutils.save_image(comparison, comparison_path, nrow=8, padding=2)

    print(f"Saved samples:")
    print(f"  {real_path}")
    print(f"  {gen_path}")
    print(f"  {comparison_path}")


def save_relational_cosine_row(model, step, epoch, in_dim):
    """
    Saves a single-row cosine-controlled visual.

    Columns are generated from z vectors with target cosine similarity
    to the first/reference vector.

    Since there is only one z-based relational space, this is one row.
    """

    model.eval()

    with torch.no_grad():
        z_row = make_cosine_similarity_row_vectors(
            in_dim=in_dim,
            device=DEVICE,
            target_sims=RELATIONAL_VIS_TARGET_SIMS,
        )

        gen_raw = model(z_row)
        gen_img = flat_to_img(gen_raw)
        gen_img = denorm(gen_img.detach().cpu())

    save_path = os.path.join(
        SAMPLE_DIR,
        f"relational_cosine_row_epoch_{epoch:04d}_step_{step:06d}.png",
    )

    n = gen_img.shape[0]

    plt.figure(figsize=(n * 2.0, 2.4))
    plt.suptitle(
        "One-row z-cosine visual | columns decrease cosine similarity to first image",
        fontsize=12,
    )

    for i in range(n):
        sim = RELATIONAL_VIS_TARGET_SIMS[i]

        plt.subplot(1, n, i + 1)
        plt.imshow(gen_img[i].permute(1, 2, 0).numpy())
        plt.title(f"{sim:.2f}", fontsize=8)
        plt.axis("off")

    plt.tight_layout()
    plt.savefig(save_path, dpi=150)
    plt.close()

    print(f"Saved relational cosine row: {save_path}")

    model.train()


