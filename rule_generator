
import random
from dataclasses import dataclass
from typing import Optional

import torch
import torch.nn.functional as F


# ============================================================
# Config defaults
# ============================================================

TASK_SIZE = 300
NUM_RULES = 1000
DATASETS_PER_RULE = 5

RANDOM_SEED = 123

PRINT_LABEL_COUNTS = True

# For the MoCo/simple MLP setup.
EXPECTED_VECTOR_DIM = 32


# ============================================================
# Bayesian neural-network rule prior
# ============================================================

BNN_RULE_FAMILY_NAME = "bayesian_neural_network"

BNN_MIN_HIDDEN_LAYERS = 1
BNN_MAX_HIDDEN_LAYERS = 3

BNN_MIN_WIDTH = 256
BNN_MAX_WIDTH = 1024

BNN_MAX_TOTAL_HIDDEN_UNITS = 2048

BNN_WEIGHT_STD = 1.25
BNN_BIAS_STD = 0.03

BNN_OUTPUT_SCALE_MIN = 0.75
BNN_OUTPUT_SCALE_MAX = 1.75

BNN_LOGIT_THRESHOLD_MIN = -0.05
BNN_LOGIT_THRESHOLD_MAX = 0.05

BNN_ACTIVATION_POOL = [
    "relu",
    "leaky_relu",
    "gelu",
    "silu",
]

# Kept available, but disabled by default.
BNN_SAME_WIDTH_RESIDUAL_PROB = 0.0
BNN_GATED_LAYER_PROB = 0.0


# ------------------------------------------------------------
# Rule balance retry heuristic
# ------------------------------------------------------------

USE_RULE_BALANCE_RETRY = True
MAX_RULE_RESAMPLE_ATTEMPTS = 10

MIN_ACCEPTABLE_POSITIVE_FRACTION = 0.30
MAX_ACCEPTABLE_POSITIVE_FRACTION = 0.70

PRINT_RULE_RESAMPLE_INFO = False


# ============================================================
# Dataclasses
# ============================================================

@dataclass
class RuleSpec:
    rule_id: int
    rule_family: str
    params: dict


@dataclass
class SyntheticImageRuleDataset:
    task_id: int
    rule_id: int
    dataset_idx_for_rule: int
    rule_spec: RuleSpec

    images: torch.Tensor
    vectors: torch.Tensor
    binary_labels: torch.Tensor
    indices: torch.Tensor

    positive_fraction: float

    # For this 32D setup, generator_inputs are the same as vectors.
    generator_inputs: Optional[torch.Tensor] = None

    # Backward-compatible alias.
    # There is no separate z in the streamer; z is the vector.
    z: Optional[torch.Tensor] = None


# ============================================================
# BNN helpers
# ============================================================

def _sample_int(low, high):
    return random.randint(int(low), int(high))


def _sample_float(low, high):
    return random.uniform(float(low), float(high))


def _sample_activation():
    return random.choice(BNN_ACTIVATION_POOL)


def _apply_activation(x, activation_name):
    if activation_name == "relu":
        return F.relu(x)

    if activation_name == "leaky_relu":
        return F.leaky_relu(x, negative_slope=0.2)

    if activation_name == "gelu":
        return F.gelu(x)

    if activation_name == "silu":
        return F.silu(x)

    raise ValueError(f"Unknown activation: {activation_name}")


def _sample_weight(out_dim, in_dim, torch_generator):
    """
    Gaussian prior with fan-in scaling.

    weight ~ N(0, BNN_WEIGHT_STD^2 / fan_in)
    """
    std = BNN_WEIGHT_STD / (float(in_dim) ** 0.5)

    return torch.randn(
        out_dim,
        in_dim,
        generator=torch_generator,
        dtype=torch.float32,
    ) * std


def _sample_bias(out_dim, torch_generator):
    return torch.randn(
        out_dim,
        generator=torch_generator,
        dtype=torch.float32,
    ) * BNN_BIAS_STD


def _choose_bnn_widths(vector_dim):
    """
    Samples a random hidden architecture.

    Input dimensionality is expected to be 32 for the current setup, but the
    function accepts vector_dim so the RuleSpec records the true input size.
    """
    depth = _sample_int(BNN_MIN_HIDDEN_LAYERS, BNN_MAX_HIDDEN_LAYERS)

    widths = []
    total_units = 0

    for _ in range(depth):
        width = _sample_int(BNN_MIN_WIDTH, BNN_MAX_WIDTH)

        if total_units + width > BNN_MAX_TOTAL_HIDDEN_UNITS:
            remaining = BNN_MAX_TOTAL_HIDDEN_UNITS - total_units

            if remaining < BNN_MIN_WIDTH:
                break

            width = min(width, remaining)

        widths.append(width)
        total_units += width

    if len(widths) == 0:
        widths = [BNN_MIN_WIDTH]

    return widths


# ============================================================
# Rule sampling
# ============================================================

def sample_rule(rule_id, vector_dim, torch_generator):
    """
    Samples one Bayesian neural-network rule.

    The sampled BNN is frozen and acts as the labeling function for all
    datasets belonging to this rule.

    Input:
        vectors: [N, vector_dim]

    For the current MoCo/simple MLP setup:
        vector_dim = 32

    Output:
        binary labels: [N]
    """
    widths = _choose_bnn_widths(vector_dim)

    layer_dims = [vector_dim] + widths + [1]

    layers = []

    for layer_idx in range(len(layer_dims) - 1):
        in_dim = layer_dims[layer_idx]
        out_dim = layer_dims[layer_idx + 1]

        weight = _sample_weight(
            out_dim=out_dim,
            in_dim=in_dim,
            torch_generator=torch_generator,
        )

        bias = _sample_bias(
            out_dim=out_dim,
            torch_generator=torch_generator,
        )

        is_output_layer = layer_idx == len(layer_dims) - 2

        if is_output_layer:
            activation = "identity"
            use_residual = False
            use_gate = False
            gate_weight = None
            gate_bias = None
        else:
            activation = _sample_activation()

            use_residual = (
                in_dim == out_dim
                and random.random() < BNN_SAME_WIDTH_RESIDUAL_PROB
            )

            use_gate = random.random() < BNN_GATED_LAYER_PROB

            if use_gate:
                gate_weight = _sample_weight(
                    out_dim=out_dim,
                    in_dim=in_dim,
                    torch_generator=torch_generator,
                )
                gate_bias = _sample_bias(
                    out_dim=out_dim,
                    torch_generator=torch_generator,
                )
            else:
                gate_weight = None
                gate_bias = None

        layers.append({
            "weight": weight,
            "bias": bias,
            "activation": activation,
            "use_residual": use_residual,
            "use_gate": use_gate,
            "gate_weight": gate_weight,
            "gate_bias": gate_bias,
        })

    output_scale = _sample_float(BNN_OUTPUT_SCALE_MIN, BNN_OUTPUT_SCALE_MAX)
    threshold = _sample_float(BNN_LOGIT_THRESHOLD_MIN, BNN_LOGIT_THRESHOLD_MAX)

    params = {
        "vector_dim": int(vector_dim),
        "widths": widths,
        "layers": layers,
        "output_scale": output_scale,
        "threshold": threshold,
        "description": (
            "Random frozen Bayesian neural-network rule. "
            "Weights are sampled from a Gaussian prior with fan-in scaling. "
            "The rule takes the full 32D synthetic generator vector as input. "
            "Each vector dimension is treated as one covariate."
        ),
    }

    return RuleSpec(
        rule_id=rule_id,
        rule_family=BNN_RULE_FAMILY_NAME,
        params=params,
    )


# ============================================================
# Apply BNN rule
# ============================================================

def _move_layer_to_device(layer, device, dtype):
    """
    Moves one stored CPU layer to the active device/dtype for evaluation.

    RuleSpec tensors are kept CPU-side by default because many tasks/rules can
    otherwise waste GPU memory.
    """
    out = {
        "weight": layer["weight"].to(device=device, dtype=dtype),
        "bias": layer["bias"].to(device=device, dtype=dtype),
        "activation": layer["activation"],
        "use_residual": layer["use_residual"],
        "use_gate": layer["use_gate"],
        "gate_weight": None,
        "gate_bias": None,
    }

    if layer["gate_weight"] is not None:
        out["gate_weight"] = layer["gate_weight"].to(device=device, dtype=dtype)

    if layer["gate_bias"] is not None:
        out["gate_bias"] = layer["gate_bias"].to(device=device, dtype=dtype)

    return out


def apply_rule(vectors, rule_spec):
    """
    Applies a sampled BNN rule to vectors.

    vectors:
        [N, vector_dim]

    For current setup:
        [N, 32]

    Returns:
        labels: binary tensor, shape [N]
    """
    if rule_spec.rule_family != BNN_RULE_FAMILY_NAME:
        raise ValueError(f"Unknown rule family: {rule_spec.rule_family}")

    p = rule_spec.params

    device = vectors.device
    dtype = vectors.dtype

    x = vectors

    expected_dim = int(p["vector_dim"])
    assert x.shape[1] == expected_dim, (
        f"Rule expected vector_dim={expected_dim}, "
        f"but got vectors with shape {tuple(x.shape)}."
    )

    for raw_layer in p["layers"]:
        layer = _move_layer_to_device(raw_layer, device=device, dtype=dtype)

        residual = x

        x_linear = x @ layer["weight"].T + layer["bias"]

        if layer["use_gate"]:
            gate = torch.sigmoid(x @ layer["gate_weight"].T + layer["gate_bias"])
            x_linear = x_linear * gate

        if layer["activation"] != "identity":
            x = _apply_activation(x_linear, layer["activation"])

            if layer["use_residual"]:
                x = x + residual
        else:
            x = x_linear

    logits = x.squeeze(1)
    logits = logits * float(p["output_scale"])

    labels = (logits > float(p["threshold"])).long()

    return labels


# ============================================================
# Label-count monitoring
# ============================================================

def summarize_binary_labels(labels):
    """
    Returns:
        num_zeros
        num_ones
        positive_fraction
    """
    labels_long = labels.long()

    num_ones = int((labels_long == 1).sum().item())
    num_zeros = int((labels_long == 0).sum().item())

    total = num_zeros + num_ones
    positive_fraction = float(num_ones / max(total, 1))

    return num_zeros, num_ones, positive_fraction


def positive_fraction_is_acceptable(positive_fraction):
    return (
        float(positive_fraction) >= float(MIN_ACCEPTABLE_POSITIVE_FRACTION)
        and float(positive_fraction) <= float(MAX_ACCEPTABLE_POSITIVE_FRACTION)
    )


def balance_distance_from_half(positive_fraction):
    return abs(float(positive_fraction) - 0.5)


def print_label_summary(
    task_id,
    rule_id,
    dataset_idx_for_rule,
    labels,
):
    """
    Monitoring only. Does not modify labels.
    """
    num_zeros, num_ones, positive_fraction = summarize_binary_labels(labels)

    print(
        f"[label counts] "
        f"task_id={task_id} | "
        f"rule_id={rule_id} | "
        f"dataset_idx_for_rule={dataset_idx_for_rule} | "
        f"zeros={num_zeros} | "
        f"ones={num_ones} | "
        f"positive_fraction={positive_fraction:.4f}"
    )

    return num_zeros, num_ones, positive_fraction


# ============================================================
# Task generator
# ============================================================

class SyntheticRuleTaskGenerator:
    """
    Generates PFN-style synthetic image-rule datasets.

    Each rule is a sampled Bayesian neural network.

    For each rule:
        - collect first dataset for that rule
        - sample a candidate BNN rule
        - label that first dataset
        - if label split is too extreme, resample the rule up to 10 times
        - accept the first rule whose first-dataset label split is 30/70 to 70/30
        - if none pass, accept the best candidate closest to 50/50
        - use the accepted rule for DATASETS_PER_RULE datasets

    The BNN input is the full vector emitted by the bank streamer.

    For the current MoCo/simple MLP setup:
        vectors are dense Gaussian 32D vectors.

    No branch/scale metadata is used.
    No chunks are zeroed out.
    """

    def __init__(
        self,
        bank_streamer,
        task_size=TASK_SIZE,
        num_rules=NUM_RULES,
        datasets_per_rule=DATASETS_PER_RULE,
        seed=RANDOM_SEED,
        print_label_counts=PRINT_LABEL_COUNTS,
        expected_vector_dim=EXPECTED_VECTOR_DIM,
        enforce_expected_vector_dim=True,
    ):
        self.bank_streamer = bank_streamer
        self.device = bank_streamer.device
        self.vector_dim = int(bank_streamer.vector_dim)

        self.task_size = int(task_size)
        self.num_rules = int(num_rules)
        self.datasets_per_rule = int(datasets_per_rule)
        self.seed = int(seed)
        self.print_label_counts = bool(print_label_counts)

        self.expected_vector_dim = int(expected_vector_dim)
        self.enforce_expected_vector_dim = bool(enforce_expected_vector_dim)

        if self.enforce_expected_vector_dim:
            assert self.vector_dim == self.expected_vector_dim, (
                f"This 32D rule-task generator expects vector_dim={self.expected_vector_dim}, "
                f"but bank_streamer.vector_dim={self.vector_dim}. "
                f"If you intentionally want a different dense vector size, pass "
                f"expected_vector_dim={self.vector_dim} or set "
                f"enforce_expected_vector_dim=False."
            )

        random.seed(seed)
        self.torch_generator = torch.Generator().manual_seed(seed)

    def _collect_task_batch(self, batch_iterator):
        """
        Collects exactly task_size samples from the bank streamer.

        Expected batch keys:
            images
            vectors
            indices

        Optional:
            generator_inputs
            z

        In this setup:
            generator_inputs = vectors
            z = vectors
        """
        images_list = []
        vectors_list = []
        idx_list = []

        generator_inputs_list = []
        z_alias_list = []

        collected = 0

        while collected < self.task_size:
            batch = next(batch_iterator)

            take = min(self.task_size - collected, batch["images"].shape[0])

            images = batch["images"][:take]
            vectors = batch["vectors"][:take]
            indices = batch["indices"][:take]

            images_list.append(images)
            vectors_list.append(vectors)
            idx_list.append(indices)

            if "generator_inputs" in batch and batch["generator_inputs"] is not None:
                generator_inputs_list.append(batch["generator_inputs"][:take])
            else:
                generator_inputs_list.append(vectors)

            if "z" in batch and batch["z"] is not None:
                z_alias_list.append(batch["z"][:take])
            else:
                z_alias_list.append(vectors)

            collected += take

        images = torch.cat(images_list, dim=0)
        vectors = torch.cat(vectors_list, dim=0)
        indices = torch.cat(idx_list, dim=0)

        generator_inputs = torch.cat(generator_inputs_list, dim=0)
        z_alias = torch.cat(z_alias_list, dim=0)

        assert vectors.shape[1] == self.vector_dim, (
            f"Collected vectors have dim={vectors.shape[1]}, "
            f"but generator expected vector_dim={self.vector_dim}."
        )

        return (
            images,
            vectors,
            indices,
            generator_inputs,
            z_alias,
        )

    def _sample_rule_with_balance_retry(
        self,
        rule_id,
        first_vectors,
    ):
        """
        Samples a BNN rule, tests it on first_vectors, and retries if the label
        split is too extreme.

        This does not alter labels and does not force exact balance.
        It only avoids obviously useless all-0/all-1 rules when possible.
        """
        if not USE_RULE_BALANCE_RETRY:
            rule = sample_rule(
                rule_id=rule_id,
                vector_dim=self.vector_dim,
                torch_generator=self.torch_generator,
            )

            labels = apply_rule(
                vectors=first_vectors,
                rule_spec=rule,
            )

            num_zeros, num_ones, positive_fraction = summarize_binary_labels(labels)
            return rule, labels, num_zeros, num_ones, positive_fraction, 1, True

        best_rule = None
        best_labels = None
        best_num_zeros = None
        best_num_ones = None
        best_positive_fraction = None
        best_distance = float("inf")

        for attempt_idx in range(MAX_RULE_RESAMPLE_ATTEMPTS):
            rule = sample_rule(
                rule_id=rule_id,
                vector_dim=self.vector_dim,
                torch_generator=self.torch_generator,
            )

            labels = apply_rule(
                vectors=first_vectors,
                rule_spec=rule,
            )

            num_zeros, num_ones, positive_fraction = summarize_binary_labels(labels)
            distance = balance_distance_from_half(positive_fraction)

            if distance < best_distance:
                best_rule = rule
                best_labels = labels
                best_num_zeros = num_zeros
                best_num_ones = num_ones
                best_positive_fraction = positive_fraction
                best_distance = distance

            if positive_fraction_is_acceptable(positive_fraction):
                accepted_attempt = attempt_idx + 1

                if PRINT_RULE_RESAMPLE_INFO and accepted_attempt > 1:
                    print(
                        f"[rule retry accepted] "
                        f"rule_id={rule_id} | "
                        f"attempt={accepted_attempt}/{MAX_RULE_RESAMPLE_ATTEMPTS} | "
                        f"zeros={num_zeros} | "
                        f"ones={num_ones} | "
                        f"positive_fraction={positive_fraction:.4f}"
                    )

                return (
                    rule,
                    labels,
                    num_zeros,
                    num_ones,
                    positive_fraction,
                    accepted_attempt,
                    True,
                )

        if PRINT_RULE_RESAMPLE_INFO:
            print(
                f"[rule retry fallback] "
                f"rule_id={rule_id} | "
                f"attempts={MAX_RULE_RESAMPLE_ATTEMPTS} | "
                f"using_best_split | "
                f"zeros={best_num_zeros} | "
                f"ones={best_num_ones} | "
                f"positive_fraction={best_positive_fraction:.4f}"
            )

        return (
            best_rule,
            best_labels,
            best_num_zeros,
            best_num_ones,
            best_positive_fraction,
            MAX_RULE_RESAMPLE_ATTEMPTS,
            False,
        )

    def datasets(self):
        batch_iterator = iter(self.bank_streamer.batches())
        task_id = 0

        for rule_id in range(self.num_rules):
            (
                first_images,
                first_vectors,
                first_indices,
                first_generator_inputs,
                first_z_alias,
            ) = self._collect_task_batch(batch_iterator)

            (
                rule,
                first_labels,
                first_num_zeros,
                first_num_ones,
                first_positive_fraction,
                rule_attempts_used,
                rule_accepted_by_balance,
            ) = self._sample_rule_with_balance_retry(
                rule_id=rule_id,
                first_vectors=first_vectors,
            )

            rule.params["balance_retry"] = {
                "enabled": USE_RULE_BALANCE_RETRY,
                "attempts_used": int(rule_attempts_used),
                "accepted_by_balance": bool(rule_accepted_by_balance),
                "min_acceptable_positive_fraction": float(MIN_ACCEPTABLE_POSITIVE_FRACTION),
                "max_acceptable_positive_fraction": float(MAX_ACCEPTABLE_POSITIVE_FRACTION),
                "first_dataset_positive_fraction": float(first_positive_fraction),
                "first_dataset_zeros": int(first_num_zeros),
                "first_dataset_ones": int(first_num_ones),
            }

            rule.params["vector_stream_metadata"] = {
                "vector_dim": int(self.vector_dim),
                "expected_vector_dim": int(self.expected_vector_dim),
                "dense_full_vector": True,
                "num_covariates": int(self.vector_dim),
                "chunking_used": False,
                "zeroing_used": False,
                "description": (
                    "The BNN receives the full dense vector as covariates. "
                    "For the current setup this is a 32D vector, with each "
                    "dimension treated as one covariate."
                ),
            }

            dataset_idx_for_rule = 0

            if self.print_label_counts:
                print(
                    f"[label counts] "
                    f"task_id={task_id} | "
                    f"rule_id={rule_id} | "
                    f"dataset_idx_for_rule={dataset_idx_for_rule} | "
                    f"zeros={first_num_zeros} | "
                    f"ones={first_num_ones} | "
                    f"positive_fraction={first_positive_fraction:.4f}"
                )

            yield SyntheticImageRuleDataset(
                task_id=task_id,
                rule_id=rule_id,
                dataset_idx_for_rule=dataset_idx_for_rule,
                rule_spec=rule,
                images=first_images,
                vectors=first_vectors,
                binary_labels=first_labels,
                indices=first_indices,
                positive_fraction=first_positive_fraction,
                generator_inputs=first_generator_inputs,
                z=first_z_alias,
            )

            task_id += 1

            for dataset_idx_for_rule in range(1, self.datasets_per_rule):
                (
                    images,
                    vectors,
                    indices,
                    generator_inputs,
                    z_alias,
                ) = self._collect_task_batch(batch_iterator)

                labels = apply_rule(
                    vectors=vectors,
                    rule_spec=rule,
                )

                num_zeros, num_ones, positive_fraction = summarize_binary_labels(labels)

                if self.print_label_counts:
                    print(
                        f"[label counts] "
                        f"task_id={task_id} | "
                        f"rule_id={rule_id} | "
                        f"dataset_idx_for_rule={dataset_idx_for_rule} | "
                        f"zeros={num_zeros} | "
                        f"ones={num_ones} | "
                        f"positive_fraction={positive_fraction:.4f}"
                    )

                yield SyntheticImageRuleDataset(
                    task_id=task_id,
                    rule_id=rule_id,
                    dataset_idx_for_rule=dataset_idx_for_rule,
                    rule_spec=rule,
                    images=images,
                    vectors=vectors,
                    binary_labels=labels,
                    indices=indices,
                    positive_fraction=positive_fraction,
                    generator_inputs=generator_inputs,
                    z=z_alias,
                )

                task_id += 1


